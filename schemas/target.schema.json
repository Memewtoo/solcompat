{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolCompat target v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "\\S" },
    "conditional": { "type": "boolean" },
    "artifact_policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["loader", "operations", "allowed_sbpf_versions"],
        "properties": {
          "loader": { "type": "string", "pattern": "\\S" },
          "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["deploy", "upgrade", "finalize", "execute"] } },
          "allowed_sbpf_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["v0", "v1", "v2", "v3"] } }
        }
      }
    }
  }
}
